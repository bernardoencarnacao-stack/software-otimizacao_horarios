<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool" name="Alocação de salas e comparação de propostas" processRef="Processo" />
  </bpmn:collaboration>
  <bpmn:process id="Processo" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="L_Gabinete" name="Gabinete de horários"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Carregar</bpmn:flowNodeRef><bpmn:flowNodeRef>Perfis</bpmn:flowNodeRef><bpmn:flowNodeRef>Personalizado</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Decisor" name="Decisor (ISCTE)"><bpmn:flowNodeRef>Ver</bpmn:flowNodeRef><bpmn:flowNodeRef>GwServe</bpmn:flowNodeRef><bpmn:flowNodeRef>Abrir</bpmn:flowNodeRef><bpmn:flowNodeRef>Escolher</bpmn:flowNodeRef><bpmn:flowNodeRef>Publicar</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Utilizadores" name="Coordenações, docentes, espaços"><bpmn:flowNodeRef>Submeter</bpmn:flowNodeRef><bpmn:flowNodeRef>Mostrar</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_App" name="Aplicação"><bpmn:flowNodeRef>Avaliar</bpmn:flowNodeRef><bpmn:flowNodeRef>GwUtil</bpmn:flowNodeRef><bpmn:flowNodeRef>Comparar</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Início do planeamento"><bpmn:outgoing>F0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Carregar" name="Carregar horário e salas"><bpmn:incoming>F0</bpmn:incoming><bpmn:outgoing>F1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Perfis" name="Calcular solução ótima (solver exato)"><bpmn:incoming>F1</bpmn:incoming><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Ver" name="Ver solução ótima e prova"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GwServe" name="Aceita esta ordem de prioridade?"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Personalizado" name="Escolher outra ordem de prioridade (extra)"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Abrir" name="Abrir período de propostas"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Submeter" name="Submeter proposta (CSV)"><bpmn:incoming>F7</bpmn:incoming><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Avaliar" name="Avaliar proposta"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GwUtil" name="Utilizável?"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Mostrar" name="Mostrar choques e aulas sem sala"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Comparar" name="Classificar: problemas, depois estabilidade da sala"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Escolher" name="Escolher proposta"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Publicar" name="Publicar horário"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End" name="Horário publicado"><bpmn:incoming>F15</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" name="" sourceRef="Start" targetRef="Carregar" />
    <bpmn:sequenceFlow id="F1" name="" sourceRef="Carregar" targetRef="Perfis" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="Perfis" targetRef="Ver" />
    <bpmn:sequenceFlow id="F3" name="" sourceRef="Ver" targetRef="GwServe" />
    <bpmn:sequenceFlow id="F4" name="não" sourceRef="GwServe" targetRef="Personalizado" />
    <bpmn:sequenceFlow id="F5" name="" sourceRef="Personalizado" targetRef="Perfis" />
    <bpmn:sequenceFlow id="F6" name="sim" sourceRef="GwServe" targetRef="Abrir" />
    <bpmn:sequenceFlow id="F7" name="" sourceRef="Abrir" targetRef="Submeter" />
    <bpmn:sequenceFlow id="F8" name="" sourceRef="Submeter" targetRef="Avaliar" />
    <bpmn:sequenceFlow id="F9" name="" sourceRef="Avaliar" targetRef="GwUtil" />
    <bpmn:sequenceFlow id="F10" name="não" sourceRef="GwUtil" targetRef="Mostrar" />
    <bpmn:sequenceFlow id="F11" name="" sourceRef="Mostrar" targetRef="Submeter" />
    <bpmn:sequenceFlow id="F12" name="sim" sourceRef="GwUtil" targetRef="Comparar" />
    <bpmn:sequenceFlow id="F13" name="" sourceRef="Comparar" targetRef="Escolher" />
    <bpmn:sequenceFlow id="F14" name="" sourceRef="Escolher" targetRef="Publicar" />
    <bpmn:sequenceFlow id="F15" name="" sourceRef="Publicar" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama">
    <bpmndi:BPMNPlane id="Plano" bpmnElement="Collab">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true"><dc:Bounds x="120" y="40" width="1610" height="640" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Gabinete_di" bpmnElement="L_Gabinete" isHorizontal="true"><dc:Bounds x="150" y="40" width="1580" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Decisor_di" bpmnElement="L_Decisor" isHorizontal="true"><dc:Bounds x="150" y="200" width="1580" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Utilizadores_di" bpmnElement="L_Utilizadores" isHorizontal="true"><dc:Bounds x="150" y="360" width="1580" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_App_di" bpmnElement="L_App" isHorizontal="true"><dc:Bounds x="150" y="520" width="1580" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="200" y="92" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="175" y="132" width="86" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carregar_di" bpmnElement="Carregar"><dc:Bounds x="270" y="70" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Perfis_di" bpmnElement="Perfis"><dc:Bounds x="410" y="70" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ver_di" bpmnElement="Ver"><dc:Bounds x="560" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwServe_di" bpmnElement="GwServe" isMarkerVisible="true"><dc:Bounds x="705" y="245" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="680" y="299" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Personalizado_di" bpmnElement="Personalizado"><dc:Bounds x="680" y="90" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Abrir_di" bpmnElement="Abrir"><dc:Bounds x="820" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Submeter_di" bpmnElement="Submeter"><dc:Bounds x="820" y="400" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Avaliar_di" bpmnElement="Avaliar"><dc:Bounds x="980" y="560" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwUtil_di" bpmnElement="GwUtil" isMarkerVisible="true"><dc:Bounds x="1125" y="575" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1100" y="629" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Mostrar_di" bpmnElement="Mostrar"><dc:Bounds x="1100" y="400" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Comparar_di" bpmnElement="Comparar"><dc:Bounds x="1230" y="560" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Escolher_di" bpmnElement="Escolher"><dc:Bounds x="1380" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Publicar_di" bpmnElement="Publicar"><dc:Bounds x="1520" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1662" y="252" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1637" y="292" width="86" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F0_di" bpmnElement="F0"><di:waypoint x="236" y="110" /><di:waypoint x="270" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="370" y="110" /><di:waypoint x="410" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="510" y="110" /><di:waypoint x="535" y="110" /><di:waypoint x="535" y="270" /><di:waypoint x="560" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="660" y="270" /><di:waypoint x="705" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="730" y="245" /><di:waypoint x="730" y="170" /><bpmndi:BPMNLabel><dc:Bounds x="736" y="227" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="730" y="90" /><di:waypoint x="730" y="55" /><di:waypoint x="460" y="55" /><di:waypoint x="460" y="70" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="755" y="270" /><di:waypoint x="820" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="761" y="274" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="870" y="310" /><di:waypoint x="870" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="920" y="460" /><di:waypoint x="950" y="460" /><di:waypoint x="950" y="600" /><di:waypoint x="980" y="600" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1080" y="600" /><di:waypoint x="1125" y="600" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1150" y="575" /><di:waypoint x="1150" y="480" /><bpmndi:BPMNLabel><dc:Bounds x="1156" y="557" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1100" y="420" /><di:waypoint x="920" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1175" y="600" /><di:waypoint x="1230" y="600" /><bpmndi:BPMNLabel><dc:Bounds x="1181" y="604" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1330" y="600" /><di:waypoint x="1355" y="600" /><di:waypoint x="1355" y="270" /><di:waypoint x="1380" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1480" y="270" /><di:waypoint x="1520" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F15_di" bpmnElement="F15"><di:waypoint x="1620" y="270" /><di:waypoint x="1662" y="270" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
